# Shopify Storefront API
EXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-token

# Shopify Customer Account API (OAuth / PKCE login)
NEXT_PUBLIC_SHOPIFY_CUSTOMER_CLIENT_ID=your-customer-account-client-id

# Base URL of this app, used to build the OAuth redirect_uri
# (e.g. http://localhost:3000 in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
